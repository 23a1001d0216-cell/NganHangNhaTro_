@model IEnumerable<Room>
@{
    ViewData["Title"] = "Trang chủ - Ngân hàng nhà trọ";
    var locations = ViewBag.LocationCategories as List<Category> ?? new();
    var roomTypes = ViewBag.RoomTypeCategories as List<Category> ?? new();
}

<!-- HERO BANNER TÌM KIẾM -->
<section style="background: linear-gradient(135deg, #0f5132 0%, #198754 100%); color: white; padding: 50px 20px 70px 20px; text-align: center;">
    <div style="max-width: 900px; margin: 0 auto;">
        <h1 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 15px;">Tìm Phòng Trọ Phù Hợp<br>Dễ Dàng & Nhanh Chóng</h1>
        <p style="font-size: 1rem; opacity: 0.9; margin-bottom: 30px;">Hệ thống tìm kiếm thông minh giúp bạn chọn đúng không gian sống mơ ước chỉ với vài click.</p>

        <!-- Thanh tìm kiếm trỏ thẳng về /Rooms hoặc giữ nguyên action của Home -->
        <form id="searchForm" action="/" method="get" style="background: white; padding: 12px; border-radius: 12px; display: flex; gap: 10px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); flex-wrap: wrap; align-items: center; text-align: left;">
            <input name="q" value="@ViewBag.Query" placeholder="Nhập tên phòng, tên đường, trọ..." style="flex: 2; min-width: 200px; padding: 10px; border: 1px solid #ddd; border-radius: 8px; outline: none; font-size: 14px;" />

            <select name="locationCategoryId" style="flex: 1; min-width: 150px; padding: 10px; border: 1px solid #ddd; border-radius: 8px; background: #fff; font-size: 14px;">
                <option value="">Tất cả khu vực</option>
                @foreach (var c in locations)
                {
                    <option value="@c.CategoryId" selected="@(ViewBag.LocationCategoryId != null && (int)ViewBag.LocationCategoryId == c.CategoryId)">@c.CategoryName</option>
                }
            </select>

            <select name="roomTypeCategoryId" style="flex: 1; min-width: 150px; padding: 10px; border: 1px solid #ddd; border-radius: 8px; background: #fff; font-size: 14px;">
                <option value="">Tất cả loại phòng</option>
                @foreach (var c in roomTypes)
                {
                    <option value="@c.CategoryId" selected="@(ViewBag.RoomTypeCategoryId != null && (int)ViewBag.RoomTypeCategoryId == c.CategoryId)">@c.CategoryName</option>
                }
            </select>

            <button type="submit" style="background: #198754; color: white; border: none; padding: 10px 24px; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 14px;">
                🔍 Tìm kiếm
            </button>
        </form>
    </div>
</section>

<!-- DANH MỤC NỔI BẬT (CHỈ CÓ Ở TRANG CHỦ) -->
<div style="max-width: 1100px; margin: 40px auto; padding: 0 20px;">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 20px;">
        <div>
            <h2 style="font-size: 22px; font-weight: bold; color: #222; margin: 0;">Danh Mục Nổi Bật</h2>
            <p style="color: #666; font-size: 14px; margin: 5px 0 0 0;">Khám phá phòng trọ theo nhu cầu của bạn</p>
        </div>
        <a href="/Rooms" style="color: #198754; text-decoration: none; font-weight: 600; font-size: 14px;">Xem tất cả &gt;</a>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px;">
        <div style="background: #fff; border: 1px solid #eaeaea; padding: 20px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
            <div style="background: #e8f5e9; width: 45px; height: 45px; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #198754; font-size: 20px; margin-bottom: 12px;">🏠</div>
            <h4 style="font-size: 16px; font-weight: bold; margin: 0 0 5px 0;">Phòng trọ sinh viên</h4>
            <p style="color: #888; font-size: 13px; margin: 0;">100+ phòng</p>
        </div>
        <div style="background: #fff; border: 1px solid #eaeaea; padding: 20px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
            <div style="background: #e3f2fd; width: 45px; height: 45px; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #0d6efd; font-size: 20px; margin-bottom: 12px;">🏢</div>
            <h4 style="font-size: 16px; font-weight: bold; margin: 0 0 5px 0;">Căn hộ chung cư mini</h4>
            <p style="color: #888; font-size: 13px; margin: 0;">90+ phòng</p>
        </div>
        <div style="background: #fff; border: 1px solid #eaeaea; padding: 20px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
            <div style="background: #fff3cd; width: 45px; height: 45px; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #ffc107; font-size: 20px; margin-bottom: 12px;">⭐</div>
            <h4 style="font-size: 16px; font-weight: bold; margin: 0 0 5px 0;">Căn hộ dịch vụ cao cấp</h4>
            <p style="color: #888; font-size: 13px; margin: 0;">100+ phòng</p>
        </div>
        <div style="background: #fff; border: 1px solid #eaeaea; padding: 20px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
            <div style="background: #f8d7da; width: 45px; height: 45px; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #dc3545; font-size: 20px; margin-bottom: 12px;">👥</div>
            <h4 style="font-size: 16px; font-weight: bold; margin: 0 0 5px 0;">Ở ghép / Homestay</h4>
            <p style="color: #888; font-size: 13px; margin: 0;">300+ phòng</p>
        </div>
    </div>
</div>

<!-- PHÒNG TRỌ MỚI NHẤT -->
<div style="max-width: 1100px; margin: 40px auto 60px auto; padding: 0 20px;">
    <h2 style="font-size: 22px; font-weight: bold; color: #222; margin-bottom: 20px;">🔥 Phòng Trọ Đang Cần Cho Thuê</h2>
    <div id="roomResults">
        @await Html.PartialAsync("_RoomCards", Model)
    </div>
</div>

@section Scripts {
    <script>
        (() => {
         const form = document.getElementById('searchForm');
         const results = document.getElementById('roomResults');
         let controller;
         if(form) {
             form.addEventListener('submit', async (e) => {
               e.preventDefault();
               if (controller) controller.abort();
               controller = new AbortController();
               const params = new URLSearchParams(new FormData(form));
               for (const [k,v] of [...params.entries()]) if (!v) params.delete(k);
               const url = '/' + (params.toString() ? '?' + params.toString() : '');
               try {
                 results.innerHTML = '<div style="text-align:center; padding:40px; color:#666;">Đang tìm phòng...</div>';
                 const response = await fetch('/?ajax=true&' + params.toString(), { headers: { 'X-Requested-With':'fetch' }, signal: controller.signal });
                 if (!response.ok) throw new Error('Không thể tải.');
                 results.innerHTML = await response.text();
                 history.replaceState(null, '', url);
               } catch (err) { if (err.name !== 'AbortError') results.innerHTML = '<div style="color:red; text-align:center;">Có lỗi xảy ra.</div>'; }
             });
         }
        })();
    </script>
}