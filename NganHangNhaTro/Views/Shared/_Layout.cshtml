
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Ngân Hàng Nhà Trọ</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/NganHangNhaTro.styles.css"
          asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>
    <!-- Thanh trên cùng -->
    <div class="top-action-bar">
        <div class="top-action-container">

            <a href="#"
               class="btn-top btn-login">
                <i class="bi bi-person-fill"></i>
                Đăng Nhập
            </a>

            <a href="#"
               class="btn-top btn-provide-room">
                <i class="bi bi-person-plus-fill"></i>
                Cung cấp thông tin nhà trọ
            </a>

        </div>
    </div>

    <!-- Thanh menu chính -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    <i class="bi bi-house-heart-fill text-primary"></i>
                    Ngân Hàng Nhà Trọ
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link fw-semibold"
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="bi bi-house-door-fill"></i>
                                TRANG CHỦ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-semibold"
                               href="#gioi-thieu">
                                <i class="bi bi-bar-chart-line-fill"></i>
                                GIỚI THIỆU
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-semibold"
                               href="#huong-dan">
                                <i class="bi bi-journal-bookmark-fill"></i>
                                HƯỚNG DẪN HỆ THỐNG
                            </a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fw-semibold"
                               href="#"
                               id="categoryDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <i class="bi bi-grid-fill"></i>
                                CÁC LOẠI NHÀ TRỌ
                            </a>

                            <ul class="dropdown-menu"
                                aria-labelledby="categoryDropdown">
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Room"
                                       asp-action="Index">
                                        Tất cả phòng trọ
                                    </a>
                                </li>
                            </ul>
                        </li>

                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <!-- Nội dung từng trang -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Chân trang -->
    <footer class="border-top text-muted py-4 mt-5">
        <div class="container text-center">
            <p class="mb-1">
                &copy; 2026 - Ngân Hàng Nhà Trọ
            </p>

            <a asp-controller="Home"
               asp-action="Privacy"
               class="text-decoration-none">
                Chính sách bảo mật
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
