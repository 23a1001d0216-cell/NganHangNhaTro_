@model IEnumerable<NganHangNhaTro.Models.Room>

@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Tìm kiếm phòng trọ";

    var locations = ViewBag.Locations as IEnumerable<NganHangNhaTro.Models.Category>
                    ?? Enumerable.Empty<NganHangNhaTro.Models.Category>();

    var roomTypes = ViewBag.RoomTypes as IEnumerable<NganHangNhaTro.Models.Category>
                    ?? Enumerable.Empty<NganHangNhaTro.Models.Category>();

    var keyword = Context.Request.Query["keyword"].ToString();
    var locationId = Context.Request.Query["locationCategoryId"].ToString();
    var roomTypeId = Context.Request.Query["roomTypeCategoryId"].ToString();
    var minPrice = Context.Request.Query["minPrice"].ToString();
    var maxPrice = Context.Request.Query["maxPrice"].ToString();
    var minArea = Context.Request.Query["minArea"].ToString();
    var maxArea = Context.Request.Query["maxArea"].ToString();
}

<div class="container py-4">

    @if (!string.IsNullOrWhiteSpace(ViewBag.FilterError as string))
    {
        <div class="alert alert-danger">
            @ViewBag.FilterError
        </div>
    }

    <div class="mb-4">
        <h1 class="fw-bold">Tìm kiếm phòng trọ</h1>
        <p class="text-muted">
            Tìm phòng phù hợp theo tên, địa chỉ, khu vực, loại phòng,
            giá thuê và diện tích.
        </p>
    </div>

    <!-- Form tìm kiếm và lọc phòng -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

            <form asp-controller="Room" asp-action="Index" method="get">

                <div class="row g-3">

                    <div class="col-12">
                        <label for="keyword" class="form-label fw-semibold">
                            Tên phòng hoặc địa chỉ
                        </label>
                        <input type="text"
                               id="keyword"
                               name="keyword"
                               value="@keyword"
                               class="form-control"
                               placeholder="Ví dụ: phòng trọ, Cầu Giấy, Hà Nội..." />
                    </div>

                    <div class="col-md-6">
                        <label for="locationCategoryId"
                               class="form-label fw-semibold">
                            Khu vực
                        </label>
                        <select id="locationCategoryId"
                                name="locationCategoryId"
                                class="form-select">
                            <option value="">Tất cả khu vực</option>
                            @foreach (var location in locations)
                            {
                                <option value="@location.CategoryId"
                                        selected="@(locationId == location.CategoryId.ToString() ? "selected" : null)">
                                    @location.CategoryName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label for="roomTypeCategoryId"
                               class="form-label fw-semibold">
                            Loại phòng
                        </label>
                        <select id="roomTypeCategoryId"
                                name="roomTypeCategoryId"
                                class="form-select">
                            <option value="">Tất cả loại phòng</option>
                            @foreach (var type in roomTypes)
                            {
                                <option value="@type.CategoryId"
                                        selected="@(roomTypeId == type.CategoryId.ToString() ? "selected" : null)">
                                    @type.CategoryName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label for="minPrice" class="form-label fw-semibold">
                            Giá thuê thấp nhất (đồng)
                        </label>
                        <input type="number"
                               id="minPrice"
                               name="minPrice"
                               value="@minPrice"
                               min="0"
                               step="100000"
                               class="form-control"
                               placeholder="Ví dụ: 1500000" />
                    </div>

                    <div class="col-md-6">
                        <label for="maxPrice" class="form-label fw-semibold">
                            Giá thuê cao nhất (đồng)
                        </label>
                        <input type="number"
                               id="maxPrice"
                               name="maxPrice"
                               value="@maxPrice"
                               min="0"
                               step="100000"
                               class="form-control"
                               placeholder="Ví dụ: 4000000" />
                    </div>

                    <div class="col-md-6">
                        <label for="minArea" class="form-label fw-semibold">
                            Diện tích nhỏ nhất (m²)
                        </label>
                        <input type="number"
                               id="minArea"
                               name="minArea"
                               value="@minArea"
                               min="0"
                               step="0.5"
                               class="form-control"
                               placeholder="Ví dụ: 15" />
                    </div>

                    <div class="col-md-6">
                        <label for="maxArea" class="form-label fw-semibold">
                            Diện tích lớn nhất (m²)
                        </label>
                        <input type="number"
                               id="maxArea"
                               name="maxArea"
                               value="@maxArea"
                               min="0"
                               step="0.5"
                               class="form-control"
                               placeholder="Ví dụ: 30" />
                    </div>

                    <div class="col-12 d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-search"></i>
                            Tìm phòng
                        </button>

                        <a asp-controller="Room"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Xóa bộ lọc
                        </a>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- Kết quả tìm kiếm -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 fw-bold mb-0">Kết quả tìm kiếm</h2>
        <span class="text-muted">
            @(Model?.Count() ?? 0) phòng
        </span>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info py-4">
            <h5 class="alert-heading">Chưa tìm thấy phòng phù hợp</h5>
            <p class="mb-2">
                Có thể chưa có phòng được duyệt hoặc không có phòng khớp
                với điều kiện tìm kiếm.
            </p>
            <p class="mb-0">
                Hãy thử đổi từ khóa, mở rộng khoảng giá hoặc chọn
                “Tất cả khu vực” và “Tất cả loại phòng”.
            </p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var room in Model)
            {
                <div class="col-sm-6 col-lg-4">
                    <div class="card room-result-card h-100 border-0 shadow-sm">

                        @if (!string.IsNullOrWhiteSpace(room.ImageUrl))
                        {
                            <img src="@room.ImageUrl"
                                 class="card-img-top room-result-image"
                                 alt="@room.Title" />
                        }
                        else
                        {
                            <div class="room-result-placeholder">
                                <i class="bi bi-house-door"></i>
                                <span>Chưa có hình ảnh</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h3 class="h5 fw-bold">@room.Title</h3>

                            <p class="text-muted mb-2">
                                <i class="bi bi-geo-alt"></i>
                                @room.Address
                            </p>

                            <p class="mb-2">
                                <i class="bi bi-rulers"></i>
                                Diện tích: @room.Area.ToString("0.##") m²
                            </p>

                            <p class="mb-2">
                                <i class="bi bi-geo"></i>
                                Khu vực: @(room.LocationCategory?.CategoryName ?? "Chưa cập nhật")
                            </p>

                            <p class="mb-3">
                                <i class="bi bi-house"></i>
                                Loại phòng: @(room.RoomTypeCategory?.CategoryName ?? "Chưa cập nhật")
                            </p>

                            <div class="mt-auto">
                                <div class="room-result-price mb-3">
                                    @room.Price.ToString("N0") đồng/tháng
                                </div>

                                <a asp-controller="Room"
                                   asp-action="Details"
                                   asp-route-id="@room.RoomId"
                                   class="btn btn-outline-success w-100">
                                    Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>

<style>
    .room-result-card {
        overflow: hidden;
        border-radius: 12px;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .room-result-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, .12) !important;
        }

    .room-result-image,
    .room-result-placeholder {
        width: 100%;
        height: 210px;
        object-fit: cover;
    }

    .room-result-placeholder {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 8px;
        background: #f0f3f2;
        color: #6c757d;
    }

        .room-result-placeholder i {
            font-size: 42px;
        }

    .room-result-price {
        color: #198754;
        font-size: 19px;
        font-weight: 700;
    }
</style>
